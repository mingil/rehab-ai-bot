# --- 📧 이메일 알림 설정 (Gmail 앱 비밀번호 권장) ---
EMAIL=
EMAIL_PASSWORD=
# 여러 명일 경우 띄어쓰기 없이 콤마(,)로 구분
EMAIL_TO=

# --- ✈️ 텔레그램 알림 설정 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 🤖 AI 설정 (Google Gemini) ---
GEMINI_API_KEY=
# 기본값: gemini-3.8-flash (장애 시 gemini-3.6-flash -> gemini-3.5-flash-lite 자동 폴백)
GEMINI_MODEL=gemini-3.8-flash

# --- 📚 Zotero 설정 (선택 사항 - 비워두면 로컬 마크다운 & 알림 전용 모드로 동작) ---
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_CANDIDATES_ID=

# --- 🔍 PubMed API 설정 (선택 사항이나 속도 향상을 위해 권장) ---
NCBI_API_KEY=

# --- ⏰ 스케줄러 및 스캔 범위 설정 (선택 사항) ---
SCHEDULE_TIME=08:00
DAYS_TO_FETCH=60
